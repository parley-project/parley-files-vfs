<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-vfs</artifactId>
	<name>Parley Files VFS</name>
	<description>parley-files FileSource implementations for the file systems Apache Commons VFS reaches
		(archives, HTTP, WebDAV, SFTP, FTP ...): one factory per VFS scheme, found at runtime through
		ServiceLoader. A scheme's own library (JSch for sftp, commons-compress for tar, httpclient5 for
		http) is added by the application that uses that scheme.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.vfs</parley.moduleName>
		<junit.version>5.11.4</junit.version>
		<commons-vfs2.version>2.10.0</commons-vfs2.version>
		<!-- The maintained JSch fork parley-files-sftp-jsch uses; VFS's sftp provider takes it
		     in place of com.jcraft:jsch (same packages). Optional: users add it for sftp. -->
		<jsch.version>2.28.7</jsch.version>
		<sshd.version>2.19.0</sshd.version>
		<!-- The version VFS 2.10.0 is built with -->
		<commons-net.version>3.11.1</commons-net.version>
		<!-- The version VFS 2.10.0 is built with; for vfstar, vfstgz, vfstbz2 and vfsbz2 (tests only:
		     users of those schemes add it) -->
		<commons-compress.version>1.27.1</commons-compress.version>
		<!-- The versions VFS 2.10.0 is built with, for vfshttp and vfshttps -->
		<httpclient5.version>5.4.1</httpclient5.version>
		<!-- The WebDAV test server: Tomcat's WebdavServlet (Tomcat 10.1 runs on Java 11) -->
		<tomcat.version>10.1.34</tomcat.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-vfs</url>
		</repository>
	</distributionManagement>

	<profiles>
		<!-- The vfshdfs tests against a real cluster: mvn test -Dparley.test.hdfs=hdfs://namenode:8020/a/dir
		     adds VFS's HDFS provider (and Hadoop's client) to the tests only then; without it they are skipped -->
		<profile>
			<id>hdfs</id>
			<activation>
				<property>
					<name>parley.test.hdfs</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.apache.commons</groupId>
					<artifactId>commons-vfs2-hdfs</artifactId>
					<version>${commons-vfs2.version}</version>
					<scope>test</scope>
				</dependency>
				<!-- VFS's own pom drops every dependency of hadoop-common, so Hadoop's are named here, nearer,
				     with theirs (the version VFS 2.10.0 is built with) -->
				<dependency>
					<groupId>org.apache.hadoop</groupId>
					<artifactId>hadoop-common</artifactId>
					<version>3.4.1</version>
					<scope>test</scope>
				</dependency>
				<dependency>
					<groupId>org.apache.hadoop</groupId>
					<artifactId>hadoop-hdfs-client</artifactId>
					<version>3.4.1</version>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<parley.test.hdfs>${parley.test.hdfs}</parley.test.hdfs>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<dependencies>
		<!-- The FileSource API this implements -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Apache Commons VFS: the one direct dependency (it brings commons-io, commons-lang3 and
		     commons-logging). Each scheme's own library is optional in VFS and not added here. -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-vfs2</artifactId>
			<version>${commons-vfs2.version}</version>
		</dependency>

		<!-- For vfsftp and vfsftps: compiled against (the permission bits read from its FTPFile),
		     optional, so it isn't passed on; users of those schemes add it, as for every scheme -->
		<dependency>
			<groupId>commons-net</groupId>
			<artifactId>commons-net</artifactId>
			<version>${commons-net.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- For vfssftp: compiled against (its permission changes are a chmod on VFS's JSch channel),
		     optional, so it isn't passed on; users of vfssftp add it, as for every scheme -->
		<dependency>
			<groupId>com.github.mwiede</groupId>
			<artifactId>jsch</artifactId>
			<version>${jsch.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- For vfshttp and vfshttps: compiled against (their own provider replaces VFS's, to check
		     certificates and to read folders), optional, so it isn't passed on; users add it -->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
			<version>${httpclient5.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- For vfswebdav and vfswebdavs: VFS's WebDAV provider (webdav4, on httpclient 4 and Jackrabbit),
		     compiled against (their own provider replaces VFS's, to check certificates), optional, so it
		     isn't passed on; users add it, and it brings httpclient and jackrabbit-webdav -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-vfs2-jackrabbit2</artifactId>
			<version>${commons-vfs2.version}</version>
			<optional>true</optional>
		</dependency>

		<!-- The shared FileSource test suite -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- The WebDAV server the vfswebdav tests start -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-core</artifactId>
			<version>${tomcat.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- For the vfstar, vfstgz, vfstbz2 and vfsbz2 tests, and to write their test archives -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-compress</artifactId>
			<version>${commons-compress.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- The SFTP server the vfssftp tests start (Apache MINA SSHD, as parley-files-sftp's tests use on Windows) -->
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-sftp</artifactId>
			<version>${sshd.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- The FTP server the vfsftp and vfsftps tests start: Parley's own, as parley-files-ftp's
		     tests use, so To-Do 17.2 compares the two against the same server -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-ftp</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
